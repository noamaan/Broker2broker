# Required for the custom server-side session cookie. Use at least 32 random bytes.
B2B_SESSION_SECRET=

# Supabase project Broker2Broker (Mumbai, ap-south-1). Never expose the secret key to browser code.
SUPABASE_URL=https://dfubbzyaoiwbbvkacwic.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# One-time owner bootstrap. Generate a private random value of at least 32 characters,
# set it only on the server, then remove it from the environment after setup succeeds.
B2B_DEVELOPER_BOOTSTRAP_TOKEN=

# Vercel Cron authentication. Set the same random secret in the hosting environment.
CRON_SECRET=

# Optional SMTP settings for time-limited password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Canonical public origin used for password-reset links; no trailing slash.
APP_BASE_URL=http://localhost:3000

# Optional OpenAI-compatible AI provider. The key never reaches the browser or Supabase.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
